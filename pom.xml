<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.tranvodev</groupId>
	<artifactId>book-app</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>book-app</name>
	<description>Repo-root aggregator: centralizes code formatting (Spotless) across all services.</description>

	<!--
		This is a standalone formatting pom. It intentionally does NOT declare the
		services as reactor <modules> so that each service keeps its own independent
		Spring Boot parent version and build lifecycle.

		Format every service's Java from the repo root:
		    mvn spotless:apply
		Check without modifying (used by the pre-commit hook / CI):
		    mvn spotless:check
	-->

	<build>
		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.44.5</version>
				<configuration>
					<java>
						<includes>
							<include>services/*/src/main/java/**/*.java</include>
							<include>services/*/src/test/java/**/*.java</include>
						</includes>
						<palantirJavaFormat/>
						<removeUnusedImports/>
						<importOrder/>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>verify</phase>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
